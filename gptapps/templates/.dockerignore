# Allow only source files needed to build the image.
**
!Dockerfile
!.dockerignore
!LICENSE
!gptapps/
gptapps/**
!gptapps/*.py
!gptapps/chat.html
!gptapps/chat.js
!gptapps/knowledge.js
!gptapps/chat.css
!gptapps/icons/
gptapps/icons/**
!gptapps/icons/*.svg
!gptapps/icons/*.md
!gptapps/icons/*.txt
!gptapps/vendor/
gptapps/vendor/**
!gptapps/vendor/*.js
!gptapps/vendor/*.md
!gptapps/vendor/*.txt
!gptapps/LICENSE
!gptapps/templates/
gptapps/templates/**
!gptapps/templates/*.sh
!gptapps/templates/Dockerfile
!gptapps/templates/.dockerignore
!scripts/
scripts/**
!scripts/docker-entrypoint.sh
